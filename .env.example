# Server
PORT=3000
NODE_ENV=development

# Redis / queue
REDIS_URL=redis://localhost:6379
JOB_TTL_SECONDS=600
WORKER_CONCURRENCY=1

# Client behavior
MAX_CLIENT_CONCURRENT_DOWNLOADS=3

# CORS (comma-separated, used in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (per IP, per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DOWNLOAD_MAX=10
RATE_LIMIT_READ_MAX=240

# Proxy download size cap (bytes, default 200 MB)
MAX_PROXY_BYTES=209715200
